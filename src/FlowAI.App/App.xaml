<Application x:Class="FlowAI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Global dark theme brushes -->
        <SolidColorBrush x:Key="AppBackground"   Color="#101211"/>
        <SolidColorBrush x:Key="AppSurface"      Color="#171918"/>
        <SolidColorBrush x:Key="AppEmerald"      Color="#00FF88"/>
        <SolidColorBrush x:Key="AppTextPrimary"  Color="#E8F5E9"/>
        <SolidColorBrush x:Key="AppTextMuted"    Color="#78909C"/>
    </Application.Resources>
</Application>
