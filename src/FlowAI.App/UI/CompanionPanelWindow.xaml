<Window x:Class="FlowAI.App.UI.CompanionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowAI"
        Width="380" Height="560"
        MinWidth="320" MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Design tokens -->
        <SolidColorBrush x:Key="BgBrush"      Color="#101211"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#171918"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#202221"/>
        <SolidColorBrush x:Key="EmeraldBrush"  Color="#00FF88"/>
        <SolidColorBrush x:Key="EmeraldDimBrush" Color="#00CC6A"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#E8F5E9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#78909C"/>
        <SolidColorBrush x:Key="ErrorBrush"    Color="#FF5252"/>
        <SolidColorBrush x:Key="BorderBrush"   Color="#2A2C2B"/>

        <!-- Scrollbar style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#171918"/>
            <Setter Property="Width" Value="6"/>
        </Style>

        <!-- Button style -->
        <Style x:Key="EmeraldButton" TargetType="Button">
            <Setter Property="Background" Value="#00FF88"/>
            <Setter Property="Foreground" Value="#101211"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00E676"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00CC6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2C2B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A1C1B"/>
                                <Setter Property="Foreground" Value="#E8F5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chat message bubble -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="#1A2E24"/>
            <Setter Property="CornerRadius" Value="12,12,2,12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="40,2,0,2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="AIBubble" TargetType="Border">
            <Setter Property="Background" Value="#171918"/>
            <Setter Property="CornerRadius" Value="12,12,12,2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,2,40,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <!-- Main rounded container -->
    <Border Background="{StaticResource BgBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.6" BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- Title bar -->
                <RowDefinition Height="Auto"/> <!-- Status bar -->
                <RowDefinition Height="*"/>    <!-- Chat transcript -->
                <RowDefinition Height="Auto"/> <!-- State indicator -->
                <RowDefinition Height="Auto"/> <!-- Input row -->
                <RowDefinition Height="Auto"/> <!-- Button row -->
            </Grid.RowDefinitions>

            <!-- ── Title bar (draggable) ── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- Emerald orb -->
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#00FF88" Offset="0"/>
                                    <GradientStop Color="#00CC6A" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00FF88" Opacity="0.8" BlurRadius="6" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="FlowAI"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Minimize / Close buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Content="─" Width="24" Height="24"
                                Style="{StaticResource GhostButton}"
                                FontSize="10" Padding="0"
                                Click="MinimizeButton_Click"
                                ToolTip="Hide panel"/>
                        <Button Content="✕" Width="24" Height="24"
                                Style="{StaticResource GhostButton}"
                                FontSize="10" Padding="0" Margin="2,0,0,0"
                                Click="CloseButton_Click"
                                ToolTip="Quit FlowAI"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Status bar ── -->
            <Border Grid.Row="1"
                    Background="{StaticResource Surface2Brush}"
                    Padding="12,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Text="Initialising…"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- AI provider badge -->
                    <Border Grid.Column="1"
                            Background="#1A2420"
                            CornerRadius="4"
                            Padding="6,2">
                        <TextBlock x:Name="ProviderBadge"
                                   Text="Ollama"
                                   Foreground="{StaticResource EmeraldBrush}"
                                   FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Chat transcript ── -->
            <ScrollViewer Grid.Row="2"
                          x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource BgBrush}"
                          Padding="8,6">
                <StackPanel x:Name="ChatPanel" Orientation="Vertical"/>
            </ScrollViewer>

            <!-- ── State indicator (animated) ── -->
            <Border Grid.Row="3"
                    x:Name="StateIndicatorBorder"
                    Background="{StaticResource Surface2Brush}"
                    Padding="12,8"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="StateOrb"
                             Width="8" Height="8"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush x:Name="StateOrbColor" Color="#00FF88"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="StateText"
                               Text="Listening…"
                               Foreground="{StaticResource EmeraldBrush}"
                               FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ── Input row ── -->
            <Border Grid.Row="4"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource Surface2Brush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <TextBox x:Name="QueryInput"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource EmeraldBrush}"
                                 BorderThickness="0"
                                 Padding="10,8"
                                 FontSize="13"
                                 AcceptsReturn="False"
                                 VerticalContentAlignment="Center"
                                 KeyDown="QueryInput_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="Placeholder" TileMode="None" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Ask FlowAI anything…"
                                                           Foreground="#4A4F4D"
                                                           FontSize="13"
                                                           Margin="10,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource Placeholder}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <Button Grid.Column="1"
                            x:Name="SendButton"
                            Content="→"
                            Width="34" Height="34"
                            Margin="6,0,0,0"
                            Style="{StaticResource EmeraldButton}"
                            FontSize="16"
                            Click="SendButton_Click"/>
                </Grid>
            </Border>

            <!-- ── Button row ── -->
            <Border Grid.Row="5"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="8,6,8,8">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Push-to-talk -->
                    <Button x:Name="PttButton"
                            Content="🎤 Hold to Talk  (Ctrl+Alt+Space)"
                            Style="{StaticResource GhostButton}"
                            Margin="2"
                            PreviewMouseLeftButtonDown="PttButton_Down"
                            PreviewMouseLeftButtonUp="PttButton_Up"
                            ToolTip="Hold to record voice query"/>

                    <Button Content="⚙ Settings"
                            Style="{StaticResource GhostButton}"
                            Margin="2"
                            Click="SettingsButton_Click"/>

                    <Button x:Name="TeachButton"
                            Content="📚 Teach"
                            Style="{StaticResource GhostButton}"
                            Margin="2"
                            Click="TeachButton_Click"
                            ToolTip="Start a workflow teaching session"/>

                    <Button Content="🧠 Memory"
                            Style="{StaticResource GhostButton}"
                            Margin="2"
                            Click="MemoryButton_Click"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Border>
</Window>
