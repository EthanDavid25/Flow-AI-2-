<Window x:Class="FlowAI.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowAI Settings"
        Width="560" Height="680"
        WindowStyle="SingleBorderWindow"
        Background="#101211"
        Foreground="#E8F5E9"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg"       Color="#101211"/>
        <SolidColorBrush x:Key="Surface"  Color="#171918"/>
        <SolidColorBrush x:Key="Surface2" Color="#202221"/>
        <SolidColorBrush x:Key="Emerald"  Color="#00FF88"/>
        <SolidColorBrush x:Key="Text"     Color="#E8F5E9"/>
        <SolidColorBrush x:Key="Muted"    Color="#78909C"/>
        <SolidColorBrush x:Key="Border"   Color="#2A2C2B"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Emerald}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="{StaticResource Bg}"
                    BorderBrush="{StaticResource Border}">

            <!-- AI & Operating Mode -->
            <TabItem Header="AI &amp; Models">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
                    <StackPanel Margin="16">
                        <Label Content="Operating Mode" FontWeight="Bold" FontSize="13"/>
                        <Separator Background="{StaticResource Border}" Margin="0,4,0,10"/>

                        <Label Content="Mode Selection"/>
                        <ComboBox x:Name="OperatingModeCombo" Margin="0,0,0,6" SelectionChanged="OperatingModeCombo_SelectionChanged">
                            <ComboBoxItem Content="AUTO — Hybrid Intelligence (Cloud preferred, local fallback)" Tag="Auto"/>
                            <ComboBoxItem Content="ONLINE — Cloud AI Only (Remote models only)" Tag="Online"/>
                            <ComboBoxItem Content="OFFLINE — Local AI Only (100% offline, zero network, zero cloud data)" Tag="Offline"/>
                        </ComboBox>
                        <TextBlock x:Name="OperatingModeDescText" FontSize="11"
                                   Foreground="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                                   Text="In AUTO mode, FlowAI uses your configured cloud AI when online and automatically falls back to Ollama if network is unavailable."/>

                        <Label Content="Local AI (Ollama)" FontWeight="Bold" FontSize="13"/>
                        <Separator Background="{StaticResource Border}" Margin="0,4,0,10"/>

                        <Label Content="Ollama Endpoint"/>
                        <TextBox x:Name="OllamaEndpointBox" Margin="0,0,0,10"/>

                        <Label Content="Ollama Model (Quantized Vision)"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OllamaModelBox"/>
                            <Button Grid.Column="1" Content="Check" Margin="6,0,0,0"
                                    Padding="10,5" Click="CheckOllama_Click"
                                    Background="{StaticResource Surface2}"
                                    Foreground="{StaticResource Emerald}"
                                    BorderBrush="{StaticResource Border}"/>
                        </Grid>
                        <TextBlock x:Name="OllamaStatusText" FontSize="11"
                                   Foreground="{StaticResource Muted}" Margin="0,0,0,16"
                                   Text="Recommended for 8 GB RAM: qwen3-vl:2b"/>

                        <Label Content="Cloud AI Providers" FontWeight="Bold" FontSize="13"/>
                        <Separator Background="{StaticResource Border}" Margin="0,4,0,10"/>

                        <Label Content="Primary Cloud Provider"/>
                        <ComboBox x:Name="CloudProviderCombo" Margin="0,0,0,10">
                            <ComboBoxItem Content="Kimi (Moonshot AI — Recommended for Vision)" Tag="Kimi"/>
                            <ComboBoxItem Content="Google Gemini (gemini-1.5-flash)" Tag="Gemini"/>
                            <ComboBoxItem Content="OpenAI (gpt-4o-mini)" Tag="OpenAI"/>
                            <ComboBoxItem Content="Anthropic Claude (claude-3-5-sonnet)" Tag="Claude"/>
                        </ComboBox>

                        <Label Content="Kimi API Key"/>
                        <PasswordBox x:Name="KimiKeyBox" Background="{StaticResource Surface2}"
                                     Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                     Padding="8,5" Margin="0,0,0,8"/>

                        <Label Content="Google Gemini API Key"/>
                        <PasswordBox x:Name="GeminiKeyBox" Background="{StaticResource Surface2}"
                                     Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                     Padding="8,5" Margin="0,0,0,8"/>

                        <Label Content="OpenAI API Key"/>
                        <PasswordBox x:Name="OpenAIKeyBox" Background="{StaticResource Surface2}"
                                     Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                     Padding="8,5" Margin="0,0,0,8"/>

                        <Label Content="Anthropic Claude API Key"/>
                        <PasswordBox x:Name="ClaudeKeyBox" Background="{StaticResource Surface2}"
                                     Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                     Padding="8,5" Margin="0,0,0,8"/>

                        <TextBlock Text="All keys are securely encrypted using Windows DPAPI machine-bound storage."
                                   FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Voice -->
            <TabItem Header="Voice">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
                    <StackPanel Margin="16">
                        <Label Content="Voice Settings" FontWeight="Bold" FontSize="13"/>
                        <Separator Background="{StaticResource Border}" Margin="0,4,0,10"/>

                        <Label Content="Hotkey"/>
                        <TextBox x:Name="HotkeyBox" IsReadOnly="True" Margin="0,0,0,4"/>
                        <TextBlock Text="Currently fixed to Ctrl+Alt+Space (configurable in future)"
                                   FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>

                        <Label Content="Microphone Input Device"/>
                        <ComboBox x:Name="InputDeviceCombo" Margin="0,0,0,16"/>

                        <Label Content="Speech Recognition (STT)"/>
                        <ComboBox x:Name="SttCombo" Margin="0,0,0,16">
                            <ComboBoxItem Content="Whisper (Local — Recommended)" Tag="Whisper"/>
                            <ComboBoxItem Content="Windows Speech Recognition" Tag="WindowsSpeech"/>
                        </ComboBox>

                        <Label Content="Whisper Model Size"/>
                        <ComboBox x:Name="WhisperModelCombo" Margin="0,0,0,4">
                            <ComboBoxItem Content="tiny  (~75 MB, fastest)" Tag="tiny"/>
                            <ComboBoxItem Content="base  (~145 MB, recommended)" Tag="base"/>
                            <ComboBoxItem Content="small (~465 MB, most accurate)" Tag="small"/>
                        </ComboBox>
                        <TextBlock Text="Models auto-downloaded on first use"
                                   FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>

                        <Label Content="Text-to-Speech (TTS)"/>
                        <ComboBox x:Name="TtsCombo" Margin="0,0,0,4">
                            <ComboBoxItem Content="Edge TTS (Free Microsoft neural voices)" Tag="EdgeTts"/>
                            <ComboBoxItem Content="Windows Speech (Built-in SAPI — 100% Offline)" Tag="WindowsSpeech"/>
                        </ComboBox>
                        <TextBlock Text="Note: Edge TTS requires an internet connection. In Offline mode, FlowAI automatically uses Windows SAPI."
                                   FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <Label Content="TTS Voice"/>
                        <TextBox x:Name="TtsVoiceBox" Margin="0,0,0,16"/>

                        <Label Content="Speed"/>
                        <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2.0" Value="1.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
                    <StackPanel Margin="16">
                        <Label Content="Appearance" FontWeight="Bold" FontSize="13"/>
                        <Separator Background="{StaticResource Border}" Margin="0,4,0,10"/>

                        <Label Content="Cursor Size"/>
                        <Slider x:Name="CursorSizeSlider" Minimum="10" Maximum="40" Value="18"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>

                        <CheckBox x:Name="ShowGlowCheck" Content="Show cursor glow" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowBboxCheck" Content="Show bounding boxes" Margin="0,0,0,8"/>

                        <Label Content="Animation Speed"/>
                        <Slider x:Name="AnimSpeedSlider" Minimum="0.5" Maximum="2.0" Value="1.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Learning -->
            <TabItem Header="Learning">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
                    <StackPanel Margin="16">
                        <Label Content="Learning &amp; Memory" FontWeight="Bold" FontSize="13"/>
                        <Separator Background="{StaticResource Border}" Margin="0,4,0,10"/>

                        <CheckBox x:Name="LearningEnabledCheck"
                                  Content="Enable self-learning (remember corrections &amp; preferences)"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="AutoCorrectCheck"
                                  Content="Automatically apply learned corrections"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="StoreScreenshotsCheck"
                                  Content="Store screenshots with workflows (privacy risk — OFF by default)"
                                  Margin="0,0,0,16"/>

                        <Label Content="Stored Memory" FontSize="12"/>
                        <TextBlock Text="View, export or delete learned data in the Memory window."
                                   Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Privacy -->
            <TabItem Header="Privacy">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
                    <StackPanel Margin="16">
                        <Label Content="Privacy" FontWeight="Bold" FontSize="13"/>
                        <Separator Background="{StaticResource Border}" Margin="0,4,0,10"/>

                        <CheckBox x:Name="ExcludeFromCaptureCheck"
                                  Content="Exclude FlowAI overlays from screen capture"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="MaskSensitiveCheck"
                                  Content="Mask sensitive form fields before sending to AI"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="RequireConfirmCheck"
                                  Content="Require confirmation before consequential automation"
                                  Margin="0,0,0,8"/>

                        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource Muted}">
                            FlowAI processes screen captures locally by default using Ollama.
                            Screenshots are never stored or sent to external services unless
                            a cloud API is enabled and active. In Offline mode, all remote requests are strictly prohibited.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Diagnostics -->
            <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}">
                    <StackPanel Margin="16">
                        <Label Content="Diagnostic Logs" FontWeight="Bold" FontSize="13"/>
                        <Separator Background="{StaticResource Border}" Margin="0,4,0,10"/>

                        <TextBlock Text="FlowAI maintains daily persistent diagnostic logs for troubleshooting."
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>

                        <Label Content="Logs Location:"/>
                        <TextBox x:Name="LogsPathBox" IsReadOnly="True" Margin="0,0,0,10"/>

                        <Button Content="Open Logs Directory" Padding="12,6" Margin="0,0,0,16"
                                HorizontalAlignment="Left"
                                Background="{StaticResource Surface2}"
                                Foreground="{StaticResource Emerald}"
                                BorderBrush="{StaticResource Border}"
                                Click="OpenLogsFolder_Click"/>

                        <Label Content="System Architecture &amp; RAM Check:" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="Designed for 8 GB RAM: Quantized vision models and on-demand screenshot inference to prevent memory pressure."
                                   Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Save / Cancel -->
        <Border Grid.Row="1"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="16,7" Margin="0,0,8,0"
                        Background="{StaticResource Surface2}"
                        Foreground="{StaticResource Muted}"
                        BorderBrush="{StaticResource Border}"
                        Click="CancelButton_Click"/>
                <Button Content="Save Settings" Padding="16,7"
                        Background="{StaticResource Emerald}"
                        Foreground="#101211" FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
