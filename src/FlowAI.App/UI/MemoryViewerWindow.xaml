<Window x:Class="FlowAI.App.UI.MemoryViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowAI Memory &amp; Learning Inspector"
        Width="780" Height="540"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#101211"
        Foreground="#E8F5E9"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg"       Color="#101211"/>
        <SolidColorBrush x:Key="Surface"  Color="#171918"/>
        <SolidColorBrush x:Key="Surface2" Color="#202221"/>
        <SolidColorBrush x:Key="Emerald"  Color="#00FF88"/>
        <SolidColorBrush x:Key="Text"     Color="#E8F5E9"/>
        <SolidColorBrush x:Key="Muted"    Color="#78909C"/>
        <SolidColorBrush x:Key="Border"   Color="#2A2C2B"/>
        <SolidColorBrush x:Key="Danger"   Color="#FF5252"/>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="RowBackground" Value="{StaticResource Surface}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Emerald}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Padding" Value="4,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Bottom bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" Padding="16,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🧠 FlowAI Local Memory &amp; Learning" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Emerald}"/>
                    <TextBlock Text="All data is stored locally in SQLite on your device (%APPDATA%\FlowAI\flowai_memory.db)" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻ Refresh" Padding="12,5" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" Click="Refresh_Click"/>
            </Grid>
        </Border>

        <!-- Tab control -->
        <TabControl Grid.Row="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}">

            <!-- Workflows -->
            <TabItem Header="Learned Workflows">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="WorkflowsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Workflow Name" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Target App" Binding="{Binding TargetApplication}" Width="110"/>
                            <DataGridTextColumn Header="Steps" Binding="{Binding Steps.Count}" Width="50"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="🗑 Delete Selected Workflow" Padding="12,6" Background="{StaticResource Surface2}" Foreground="{StaticResource Danger}" BorderBrush="{StaticResource Border}" Click="DeleteWorkflow_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Corrections -->
            <TabItem Header="User Corrections">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="CorrectionsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="120"/>
                            <DataGridTextColumn Header="User Query" Binding="{Binding UserQuery}" Width="160"/>
                            <DataGridTextColumn Header="Wrong Target" Binding="{Binding WrongTargetLabel}" Width="130"/>
                            <DataGridTextColumn Header="Corrected Target" Binding="{Binding CorrectedTargetLabel}" Width="140"/>
                            <DataGridTextColumn Header="Recorded" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="🗑 Delete Selected Correction" Padding="12,6" Background="{StaticResource Surface2}" Foreground="{StaticResource Danger}" BorderBrush="{StaticResource Border}" Click="DeleteCorrection_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- User Preferences -->
            <TabItem Header="User Preferences">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="PreferencesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="180"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="🗑 Delete Selected Preference" Padding="12,6" Background="{StaticResource Surface2}" Foreground="{StaticResource Danger}" BorderBrush="{StaticResource Border}" Click="DeletePreference_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Task History -->
            <TabItem Header="Task History">
                <Grid Margin="12">
                    <DataGrid x:Name="HistoryGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Query" Binding="{Binding TaskQuery}" Width="200"/>
                            <DataGridTextColumn Header="App" Binding="{Binding ApplicationName}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Success" Binding="{Binding IsSuccess}" Width="60"/>
                            <DataGridTextColumn Header="Model" Binding="{Binding ModelUsed}" Width="110"/>
                            <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMilliseconds, StringFormat=\{0:F0\}}" Width="90"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" Padding="12,8" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="⚠ Clear All Memory Data" HorizontalAlignment="Left" Padding="12,6" Background="{StaticResource Surface2}" Foreground="{StaticResource Danger}" BorderBrush="{StaticResource Border}" Click="ClearAll_Click"/>
                <Button Content="Close" HorizontalAlignment="Right" Padding="20,6" Background="{StaticResource Emerald}" Foreground="#101211" FontWeight="SemiBold" BorderThickness="0" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
